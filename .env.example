# Copy to .env and fill in. .env is gitignored; this example is not.
# Loaded by harness/repl.py at startup, before the Anthropic client is built.
# Anything already exported in your shell wins over these values.

# Credential for the acting model. Required: the harness calls the Anthropic API
# directly, so a Claude Code login is not used.
ANTHROPIC_API_KEY=

# Optional: MuJoCo renderer backend, when the default choice fails.
# egl (Linux/NVIDIA), osmesa (CPU-only), glfw (desktop), cgl (macOS).
# MUJOCO_GL=osmesa
